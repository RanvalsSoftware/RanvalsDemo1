<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_event_list" model="ir.ui.view">
        <field name="name">meta.lead.event.list</field>
        <field name="model">meta.lead.event</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state == 'retry'">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="meta_leadgen_id"/>
                <field name="form_name" optional="show"/>
                <field name="campaign_name" optional="show"/>
                <field name="ad_name" optional="hide"/>
                <field name="platform" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="result" optional="show"/>
                <field name="attempts"/>
                <field name="next_retry_at" optional="hide"/>
                <field name="crm_lead_id"/>
                <button name="action_process_now" type="object" icon="fa-play" title="Process now" invisible="state not in ['pending', 'retry']"/>
                <button name="action_retry" type="object" icon="fa-refresh" title="Retry" invisible="state != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_event_search" model="ir.ui.view">
        <field name="name">meta.lead.event.search</field>
        <field name="model">meta.lead.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="meta_leadgen_id"/>
                <field name="connection_id"/>
                <field name="campaign_name"/>
                <field name="form_id"/>
                <field name="ad_id"/>
                <field name="crm_lead_id"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ['pending', 'retry', 'processing'])]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="test" string="Test Events" domain="[('is_test', '=', True)]"/>
                <group>
                    <filter name="connection" string="Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="day" string="Received Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_meta_lead_event_form" model="ir.ui.view">
        <field name="name">meta.lead.event.form</field>
        <field name="model">meta.lead.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_process_now" type="object" string="Process Now" class="oe_highlight" invisible="state not in ['pending', 'retry']"/>
                    <button name="action_retry" type="object" string="Retry" class="oe_highlight" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,retry,done,failed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Test" bg_color="text-bg-info" invisible="not is_test"/>
                    <div class="oe_title">
                        <label for="meta_leadgen_id"/>
                        <h1><field name="meta_leadgen_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="connection_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="page_id" readonly="1"/>
                            <field name="meta_created_time" readonly="1"/>
                            <field name="is_test" readonly="1"/>
                        </group>
                        <group>
                            <field name="result" readonly="1"/>
                            <field name="crm_lead_id" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                            <field name="last_attempt_at" readonly="1"/>
                            <field name="next_retry_at" readonly="1"/>
                            <field name="processed_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attribution">
                            <group>
                                <group>
                                    <field name="form_id" readonly="1"/>
                                    <field name="form_name" readonly="1"/>
                                    <field name="campaign_id" readonly="1"/>
                                    <field name="campaign_name" readonly="1"/>
                                    <field name="platform" readonly="1"/>
                                </group>
                                <group>
                                    <field name="adset_id" readonly="1"/>
                                    <field name="adset_name" readonly="1"/>
                                    <field name="ad_id" readonly="1"/>
                                    <field name="ad_name" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Error" invisible="not last_error">
                            <field name="last_error" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Retained Payloads" invisible="not webhook_payload and not lead_payload">
                            <div class="alert alert-warning" role="alert">Payloads may contain personal data. Access is restricted to system administrators and the retention cron clears them automatically.</div>
                            <group>
                                <field name="webhook_payload" readonly="1" widget="text"/>
                                <field name="lead_payload" readonly="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_meta_lead_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">meta.lead.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_lead_event_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Meta webhook events yet</p>
            <p>Use the connection's built-in test wizard or Meta Lead Ads Testing Tool.</p>
        </field>
    </record>
</odoo>
