<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_routing_rule_list" model="ir.ui.view">
        <field name="name">meta.lead.routing.rule.list</field>
        <field name="model">meta.lead.routing.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="match_field"/>
                <field name="match_value" invisible="match_field == 'any'"/>
                <field name="company_id" column_invisible="1"/>
                <field name="team_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_routing_rule_form" model="ir.ui.view">
        <field name="name">meta.lead.routing.rule.form</field>
        <field name="model">meta.lead.routing.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="name"/>
                        <field name="connection_id"/>
                        <field name="company_id" readonly="1"/>
                        <field name="match_field"/>
                        <field name="match_value" invisible="match_field == 'any'"/>
                        <field name="team_id"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_meta_lead_routing_rule" model="ir.actions.act_window">
        <field name="name">Routing Rules</field>
        <field name="res_model">meta.lead.routing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
