<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_test_wizard_form" model="ir.ui.view">
        <field name="name">meta.lead.test.wizard.form</field>
        <field name="model">meta.lead.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Test Meta Lead">
                <group>
                    <field name="connection_id" readonly="1"/>
                    <field name="full_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="company_name"/>
                    <field name="platform"/>
                </group>
                <notebook>
                    <page string="Attribution">
                        <group>
                            <group>
                                <field name="campaign_id"/>
                                <field name="campaign_name"/>
                                <field name="adset_id"/>
                                <field name="adset_name"/>
                            </group>
                            <group>
                                <field name="ad_id"/>
                                <field name="ad_name"/>
                                <field name="form_id"/>
                                <field name="form_name"/>
                            </group>
                        </group>
                    </page>
                    <page string="Custom Answers">
                        <field name="custom_answers" nolabel="1" placeholder="question=value"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_test_lead" type="object" string="Create CRM Lead" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

