<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_rds" model="ir.ui.view">
        <field name="name">purchase.order.form.rds</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_rds_export"
                        type="object"
                        string="Print with DocuCraft"
                        icon="fa-print"
                        class="btn-primary rds-docucraft-print-button"
                        invisible="not id"
                        groups="purchase.group_purchase_user"
                        help="Choose the design, document language, and PDF, Word, PNG, or ZIP format in one dialog."/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_open_rds_export" type="object" string="Print with DocuCraft" icon="fa-print" class="btn-primary rds-docucraft-print-button" groups="purchase.group_purchase_user" help="Choose the design and output format for the selected documents in one dialog."/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_open_rds_export" type="object" string="Print with DocuCraft" icon="fa-print" class="btn-primary rds-docucraft-print-button" groups="purchase.group_purchase_user" help="Choose the design and output format for the selected documents in one dialog."/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_main_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.main.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_open_rds_export" type="object" string="Print with DocuCraft" icon="fa-print" class="btn-primary rds-docucraft-print-button" groups="purchase.group_purchase_user" help="Choose the design and output format for the selected documents in one dialog."/>
            </xpath>
        </field>
    </record>
</odoo>
