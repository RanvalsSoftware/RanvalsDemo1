<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_rds" model="ir.ui.view">
        <field name="name">purchase.order.form.rds</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rds_download_pdf"
                        type="object"
                        string="PDF İndir"
                        icon="fa-file-pdf-o"
                        class="btn-secondary"
                        invisible="not id"
                        groups="purchase.group_purchase_user"
                        help="Etkin DocuCraft tasarımını tedarikçi dilinde doğrudan PDF olarak indirin."/>
                <button name="action_rds_download_editable_word"
                        type="object"
                        string="Word İndir"
                        icon="fa-file-word-o"
                        class="btn-primary"
                        invisible="not id"
                        groups="purchase.group_purchase_user"
                        help="Belgeyi düzenlenebilir Word dosyası olarak indirin."/>
                <button name="action_open_rds_export"
                        type="object"
                        string="Diğer Biçimler"
                        icon="fa-ellipsis-h"
                        class="btn-link"
                        invisible="not id"
                        groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_rds_download_pdf" type="object" string="PDF İndir" icon="fa-file-pdf-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
                    <button name="action_rds_download_editable_word" type="object" string="Word İndir" icon="fa-file-word-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_rds_download_pdf" type="object" string="PDF İndir" icon="fa-file-pdf-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
                <button name="action_rds_download_editable_word" type="object" string="Word İndir" icon="fa-file-word-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_main_list_rds_quick_export" model="ir.ui.view">
        <field name="name">purchase.order.main.list.rds.quick.export</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_rds_download_pdf" type="object" string="PDF İndir" icon="fa-file-pdf-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
                <button name="action_rds_download_editable_word" type="object" string="Word İndir" icon="fa-file-word-o" class="btn-secondary" groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
