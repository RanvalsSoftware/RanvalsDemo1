<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rds_export_job_list" model="ir.ui.view">
        <field name="name">rds.export.job.list</field>
        <field name="model">rds.export.job</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  js_class="rds_sidebar_list"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'">
                <field name="requested_at"/>
                <field name="name"/>
                <field name="record_names"/>
                <field name="template_id"/>
                <field name="output_format"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('queued', 'running')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
                <field name="progress" widget="progressbar"/>
                <field name="file_size_display" string="Size" optional="show"/>
                <field name="has_file" column_invisible="True"/>
                <button name="action_download" type="object" string="Download"
                        icon="fa-download" invisible="state != 'done' or not has_file"/>
                <button name="action_cancel" type="object" string="Cancelled"
                        icon="fa-ban" invisible="state != 'queued'"/>
                <button name="action_retry" type="object" string="Retry"
                        icon="fa-repeat" invisible="state not in ('failed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_rds_export_job_form" model="ir.ui.view">
        <field name="name">rds.export.job.form</field>
        <field name="model">rds.export.job</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" js_class="rds_sidebar_form">
                <header>
                    <button name="action_download" type="object" string="Download File"
                            icon="fa-download" class="btn-primary"
                            invisible="state != 'done' or not has_file"/>
                    <button name="action_cancel" type="object" string="Cancelled"
                            icon="fa-ban" invisible="state != 'queued'"/>
                    <button name="action_retry" type="object" string="Queue Again"
                            icon="fa-repeat" class="btn-secondary"
                            invisible="state not in ('failed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,running,done,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="requested_at"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="output_format"/>
                            <field name="language_id"/>
                            <field name="record_count"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <group string="Progress">
                        <field name="progress" widget="progressbar" nolabel="1"/>
                    </group>
                    <group string="Source Documents">
                        <field name="record_names"/>
                        <field name="res_model"/>
                        <field name="res_ids_json"/>
                        <field name="rds_source_report_id" groups="base.group_system"/>
                        <field name="source_report_expected" invisible="True"/>
                        <field name="attach_to_record"/>
                    </group>
                    <group string="Output" invisible="state != 'done'">
                        <field name="file_name"/>
                        <field name="file_mimetype"/>
                        <field name="file_size_display"/>
                        <field name="has_file" invisible="True"/>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rds_export_job_search" model="ir.ui.view">
        <field name="name">rds.export.job.search</field>
        <field name="model">rds.export.job</field>
        <field name="arch" type="xml">
            <search string="Search Background Jobs">
                <field name="name"/>
                <field name="record_names"/>
                <field name="template_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="active_jobs" string="Active Jobs" domain="[('state', 'in', ('queued', 'running'))]"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="running" string="Preparing" domain="[('state', '=', 'running')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_format" string="Format" context="{'group_by': 'output_format'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rds_export_job" model="ir.actions.act_window">
        <field name="name">My Background Jobs</field>
        <field name="res_model">rds.export.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rds_export_job_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No background exports yet</p>
            <p>Queue large or multi-record documents from the export dialog.</p>
        </field>
    </record>

    <menuitem id="menu_rds_export_jobs"
              name="My Background Jobs"
              parent="menu_rds_root"
              action="action_rds_export_job"
              sequence="25"
              groups="base.group_user"/>
</odoo>
