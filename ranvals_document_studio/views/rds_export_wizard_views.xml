<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rds_export_wizard_form" model="ir.ui.view">
        <field name="name">rds.export.wizard.form</field>
        <field name="model">rds.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Print with DocuCraft" class="rds-export-wizard">
                <sheet class="rds-export-wizard__sheet">
                    <div class="rds-export-wizard__intro">
                        <span class="rds-export-wizard__intro-icon" aria-hidden="true"><i class="fa fa-print" title="Print with DocuCraft"/></span>
                        <div>
                            <h2>Print with DocuCraft</h2>
                            <p>Choose your corporate design, document language, and output format in one place.</p>
                        </div>
                    </div>
                    <notebook class="rds-export-workspace">
                        <page string="Preview" name="preview">
                            <div class="rds-export-page rds-export-page--preview">
                                <div class="rds-export-options-grid">
                                    <section class="rds-export-option-card">
                                        <div class="rds-export-option-card__header">
                                            <span class="rds-export-option-card__icon">
                                                <i class="fa fa-file-text-o" title="Document and design"/>
                                            </span>
                                            <span>
                                                <strong>Document and Design</strong>
                                                <small>Choose the template and the company, customer, or custom document language.</small>
                                            </span>
                                        </div>
                                        <div class="rds-export-option-card__body">
                                            <div class="rds-export-control">
                                                <label for="record_count"/>
                                                <field name="record_count" nolabel="1" readonly="1"/>
                                            </div>
                                            <div class="rds-export-control">
                                                <label for="template_id"/>
                                                <field name="template_id"
                                                       nolabel="1"
                                                       options="{'no_create': True, 'no_open': False}"/>
                                            </div>
                                            <div class="rds-export-control">
                                                <label for="language_mode"/>
                                                <field name="language_mode" nolabel="1"/>
                                            </div>
                                            <div class="rds-export-control">
                                                <label for="language_id"/>
                                                <field name="language_id"
                                                       nolabel="1"
                                                       readonly="language_mode != 'manual'"
                                                       force_save="1"
                                                       options="{'no_create': True}"/>
                                                <small class="rds-export-language-note" invisible="language_mode == 'manual'">Automatic field labels are translated into this language.</small>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="rds-export-option-card">
                                        <div class="rds-export-option-card__header">
                                            <span class="rds-export-option-card__icon rds-export-option-card__icon--format">
                                                <i class="fa fa-download" title="Export options"/>
                                            </span>
                                            <span>
                                                <strong>Export Options</strong>
                                                <small>Choose the file type and download behavior.</small>
                                            </span>
                                        </div>
                                        <div class="rds-export-option-card__body">
                                            <div class="rds-export-control rds-export-control--format">
                                                <label for="output_format"/>
                                                <field name="output_format" widget="radio" nolabel="1"/>
                                            </div>
                                            <div class="rds-export-control" invisible="output_format not in ('png', 'zip')">
                                                <label for="dpi"/>
                                                <field name="dpi" nolabel="1"/>
                                            </div>
                                            <div class="rds-export-format-note alert alert-success" role="status" invisible="output_format != 'docx_editable'">
                                                Editable Word creates headings, lines, amounts, notes, and bank details as real Word text and tables.
                                            </div>
                                            <div class="rds-export-format-note alert alert-info" role="status" invisible="output_format != 'docx'">
                                                PDF-layout Word preserves the design exactly; text cannot be edited because pages are high-resolution images.
                                            </div>
                                            <div class="rds-export-format-note alert alert-info" role="status" invisible="output_format != 'zip'">
                                                The ZIP package includes a PDF, editable Word, PDF-layout Word, and high-resolution PNG pages for every selected record.
                                            </div>
                                            <div class="rds-export-switch">
                                                <field name="attach_to_record" nolabel="1"/>
                                                <label for="attach_to_record"/>
                                            </div>
                                            <div class="rds-export-control">
                                                <label for="file_name_prefix"/>
                                                <field name="file_name_prefix" nolabel="1" placeholder="Optional"/>
                                            </div>
                                        </div>
                                    </section>
                                </div>

                                <section class="rds-export-preview">
                                    <div class="rds-export-preview__heading">
                                        <span>
                                            <strong>Design Preview</strong>
                                            <small>Shows the selected document's real data, language, design, and enabled fields.</small>
                                        </span>
                                        <span class="rds-export-preview__badge">Live</span>
                                    </div>
                                    <field name="template_preview_html"
                                           class="rds-export-preview__content"
                                           widget="html"
                                           nolabel="1"
                                           readonly="1"/>
                                </section>
                            </div>
                        </page>

                        <page string="Fields" name="fields">
                            <div class="rds-export-page rds-export-page--fields">
                                <section class="rds-export-fields-panel">
                                    <div class="rds-export-fields-panel__header">
                                        <div class="rds-export-fields-panel__title">
                                            <span class="rds-export-fields-panel__icon">
                                                <i class="fa fa-sliders" title="Document fields"/>
                                            </span>
                                            <span>
                                                <strong>Fields Included in the Document</strong>
                                                <small>Green fields are included in PDF, Word, PNG, and ZIP exports; gray fields are excluded. You can edit labels and drag fields to reorder them. Automatic labels follow the selected document language. You can select up to 24 document details and 12 line columns.</small>
                                            </span>
                                        </div>
                                        <div class="rds-export-fields-panel__summary" aria-label="Field summary">
                                            <span class="rds-export-count rds-export-count--enabled">
                                                <i class="fa fa-check-circle" title="Enabled fields"/>
                                                <field name="enabled_field_count" nolabel="1" readonly="1"/> enabled
                                            </span>
                                            <span class="rds-export-count">
                                                <field name="total_field_count" nolabel="1" readonly="1"/> total
                                            </span>
                                        </div>
                                    </div>
                                    <div class="rds-export-fields-panel__sections">
                                        <span>
                                            <i class="fa fa-id-card-o" title="Document details"/>
                                            Document details
                                            <strong><field name="metadata_field_count" nolabel="1" readonly="1"/></strong>
                                        </span>
                                        <span>
                                            <i class="fa fa-list-alt" title="Line columns"/>
                                            Line columns
                                            <strong><field name="line_field_count" nolabel="1" readonly="1"/></strong>
                                        </span>
                                    </div>
                                    <field name="field_line_ids" class="rds-export-fields-list" nolabel="1">
                                        <list editable="bottom"
                                              create="0"
                                              delete="0"
                                              decoration-success="enabled"
                                              decoration-muted="not enabled">
                                            <field name="source_model" column_invisible="1" readonly="1" force_save="1"/>
                                            <field name="field_key" column_invisible="1" readonly="1" force_save="1"/>
                                            <field name="origin" column_invisible="1" readonly="1" force_save="1"/>
                                            <field name="auto_label" column_invisible="1" readonly="1" force_save="1"/>
                                            <field name="sequence" widget="handle"/>
                                            <field name="enabled" widget="boolean_toggle" string="Include"/>
                                            <field name="section"
                                                   widget="badge"
                                                   readonly="1"
                                                   force_save="1"
                                                   decoration-info="section == 'metadata'"
                                                   decoration-warning="section == 'line'"/>
                                            <field name="label" string="Label"/>
                                            <field name="sample_value" string="Sample Value" readonly="1" force_save="1"/>
                                            <field name="field_path" string="Source Field" readonly="1" force_save="1" optional="show"/>
                                            <field name="is_custom" string="Custom" widget="boolean_favorite" readonly="1" force_save="1" optional="show"/>
                                        </list>
                                    </field>
                                </section>
                            </div>
                        </page>
                    </notebook>
                    <field name="res_model" invisible="1"/>
                    <field name="available_template_ids" invisible="1"/>
                    <field name="field_selection_mode" invisible="1"/>
                    <field name="res_ids_json" invisible="1"/>
                    <field name="file_data" invisible="1"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_mimetype" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview PDF" class="btn-secondary" icon="fa-eye" invisible="output_format != 'pdf' or record_count != 1"/>
                    <button name="action_export" type="object" string="Generate and Download" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_rds_field_add_wizard_form" model="ir.ui.view">
        <field name="name">rds.field.add.wizard.form</field>
        <field name="model">rds.field.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Field to Template">
                <group>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="section"/>
                    <field name="source_model_id" options="{'no_create': True}"/>
                    <field name="field_id" options="{'no_create': True}" domain="[('model_id', '=', source_model_id)]"/>
                    <field name="field_path" placeholder="e.g. partner_id.vat"/>
                    <field name="label"/>
                </group>
                <group string="Appearance">
                    <field name="sequence"/>
                    <field name="icon_class"/>
                    <field name="value_type"/>
                    <field name="alignment"/>
                    <field name="width_percent"/>
                    <field name="hide_if_empty"/>
                    <field name="bold"/>
                    <field name="highlight"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Add Field" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
