<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_rds" model="ir.ui.view">
        <field name="name">sale.order.form.rds</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rds_download_pdf"
                        type="object"
                        string="PDF İndir"
                        icon="fa-file-pdf-o"
                        class="btn-secondary"
                        invisible="not id"
                        groups="sales_team.group_sale_salesman"
                        help="Etkin DocuCraft tasarımını müşteri dilinde doğrudan PDF olarak indirin."/>
                <button name="action_rds_download_editable_word"
                        type="object"
                        string="Word İndir"
                        icon="fa-file-word-o"
                        class="btn-primary"
                        invisible="not id"
                        groups="sales_team.group_sale_salesman"
                        help="Etkin DocuCraft tasarımını düzenlenebilir Word belgesi olarak indirin."/>
                <button name="action_open_rds_export"
                        type="object"
                        string="Diğer Biçimler"
                        icon="fa-ellipsis-h"
                        class="btn-link"
                        invisible="not id"
                        groups="sales_team.group_sale_salesman"
                        help="Tasarım seçerek PDF, Word veya PNG oluşturun. Hazır PDF tasarımları Yazdır menüsünde de yer alır."/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list_rds_quick_export" model="ir.ui.view">
        <field name="name">sale.order.list.rds.quick.export</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_rds_download_pdf"
                        type="object"
                        string="PDF İndir"
                        icon="fa-file-pdf-o"
                        class="btn-secondary"
                        groups="sales_team.group_sale_salesman"
                        help="Seçilen belgeleri PDF olarak indirin."/>
                <button name="action_rds_download_editable_word"
                        type="object"
                        string="Word İndir"
                        icon="fa-file-word-o"
                        class="btn-secondary"
                        groups="sales_team.group_sale_salesman"
                        help="Seçilen belgeleri düzenlenebilir Word olarak indirin."/>
            </xpath>
        </field>
    </record>
</odoo>
