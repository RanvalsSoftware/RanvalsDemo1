<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_rds" model="ir.ui.view">
        <field name="name">sale.order.form.rds</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_rds_export"
                        type="object"
                        string="DocuCraft Yazdır"
                        icon="fa-print"
                        class="btn-primary rds-docucraft-print-button"
                        invisible="not id"
                        groups="sales_team.group_sale_salesman"
                        help="Tasarım, belge dili ve PDF, Word, PNG veya ZIP biçimini tek pencereden seçin."/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list_rds_quick_export" model="ir.ui.view">
        <field name="name">sale.order.list.rds.quick.export</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_open_rds_export"
                        type="object"
                        string="DocuCraft Yazdır"
                        icon="fa-print"
                        class="btn-primary rds-docucraft-print-button"
                        groups="sales_team.group_sale_salesman"
                        help="Seçilen belgeler için tasarım ve çıktı biçimini tek pencereden seçin."/>
            </xpath>
        </field>
    </record>
</odoo>
