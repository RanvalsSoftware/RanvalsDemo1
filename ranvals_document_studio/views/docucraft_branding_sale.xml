<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_rds_docucraft_branding" model="ir.ui.view">
        <field name="name">sale.order.form.rds.docucraft.branding</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="ranvals_document_studio.view_sale_order_form_rds"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_rds_export']" position="attributes">
                <attribute name="string">DocuCraft / Özel Yazdır</attribute>
                <attribute name="help">DocuCraft tasarımı seçerek PDF, Word / DOCX veya PNG oluşturun.</attribute>
            </xpath>
        </field>
    </record>

    <record id="server_action_sale_rds_export" model="ir.actions.server">
        <field name="name">DocuCraft</field>
    </record>
    <record id="server_action_sale_rds_print" model="ir.actions.server">
        <field name="name">DocuCraft – Özel Yazdır</field>
    </record>

    <record id="action_report_rds_sale_document" model="ir.actions.report">
        <field name="name">DocuCraft – Varsayılan Tasarım</field>
    </record>
    <record id="action_report_rds_sale_beauty_document" model="ir.actions.report">
        <field name="name">DocuCraft – Premium Bordo / Güzellik ve Sağlık</field>
    </record>
    <record id="action_report_rds_sale_construction_document" model="ir.actions.report">
        <field name="name">DocuCraft – Kurumsal Lacivert / İnşaat ve Mühendislik</field>
    </record>
    <record id="action_report_rds_sale_technology_document" model="ir.actions.report">
        <field name="name">DocuCraft – Modern Mavi / Teknoloji ve Yazılım</field>
    </record>
    <record id="action_report_rds_sale_industrial_document" model="ir.actions.report">
        <field name="name">DocuCraft – Endüstriyel / Üretim ve Makine</field>
    </record>
    <record id="action_report_rds_sale_eco_document" model="ir.actions.report">
        <field name="name">DocuCraft – Doğal Yeşil / Mimarlık ve Sürdürülebilirlik</field>
    </record>
    <record id="action_report_rds_sale_furniture_document" model="ir.actions.report">
        <field name="name">DocuCraft – Terakota / Mobilya ve İç Mimarlık</field>
    </record>
</odoo>
