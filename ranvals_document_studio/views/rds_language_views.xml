<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rds_language_wizard" model="ir.ui.view">
        <field name="name">rds.language.wizard.form</field>
        <field name="model">rds.language.wizard</field>
        <field name="arch" type="xml">
            <form string="DocuCraft Language Settings">
                <div class="alert alert-info" role="status">
                    The interface language changes only your Odoo user preference. Other users and the customer's document language are not affected. The page reloads when you apply it.
                </div>
                <group><field name="language_code"/><field name="language_active" invisible="1"/><field name="missing_language_count" invisible="1"/></group>
                <div class="alert alert-warning" invisible="language_active" role="alert">
                    This language is not active yet. A system administrator can activate it and the installed modules' translations with the button below.
                </div>
                <p class="text-muted">You can choose the document language for PDF, Word, and PNG separately in the export dialog or DocuCraft Studio design panel.</p>
                <footer>
                    <button name="action_apply" type="object" string="Apply Language" class="btn-primary" invisible="not language_active"/>
                    <button name="action_activate_language" type="object" string="Activate Selected Language" class="btn-secondary" groups="base.group_system" invisible="language_active"/>
                    <button name="action_activate_supported_languages" type="object" string="Activate Supported Languages" class="btn-secondary" groups="base.group_system" invisible="not missing_language_count"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rds_language_wizard" model="ir.actions.act_window">
        <field name="name">DocuCraft Language Settings</field><field name="res_model">rds.language.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="access_rds_language_wizard_user" model="ir.model.access">
        <field name="name">rds.language.wizard.user</field><field name="model_id" ref="model_rds_language_wizard"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
</odoo>
