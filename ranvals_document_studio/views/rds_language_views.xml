<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rds_language_wizard" model="ir.ui.view">
        <field name="name">rds.language.wizard.form</field>
        <field name="model">rds.language.wizard</field>
        <field name="arch" type="xml">
            <form string="DocuCraft Dil Ayarları">
                <div class="alert alert-info" role="status">
                    Arayüz dili yalnız sizin Odoo kullanıcı tercihinizi değiştirir. Diğer kullanıcılar ve müşterinin belge dili etkilenmez. Uygularken sayfa yeniden yüklenir.
                </div>
                <group><field name="language_code"/><field name="language_active" invisible="1"/><field name="missing_language_count" invisible="1"/></group>
                <div class="alert alert-warning" invisible="language_active" role="alert">
                    Bu dil henüz etkin değil. Sistem yöneticisi aşağıdaki düğmeyle dili ve yüklü modüllerin çevirilerini etkinleştirebilir.
                </div>
                <p class="text-muted">PDF, Word ve PNG için belge dilini dışa aktarım penceresinden veya DocuCraft Studio tasarım panelinden ayrıca seçebilirsiniz.</p>
                <footer>
                    <button name="action_apply" type="object" string="Dili Uygula" class="btn-primary" invisible="not language_active"/>
                    <button name="action_activate_language" type="object" string="Seçilen Dili Etkinleştir" class="btn-secondary" groups="base.group_system" invisible="language_active"/>
                    <button name="action_activate_supported_languages" type="object" string="Desteklenen Dilleri Etkinleştir" class="btn-secondary" groups="base.group_system" invisible="not missing_language_count"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rds_language_wizard" model="ir.actions.act_window">
        <field name="name">DocuCraft Dil Ayarları</field><field name="res_model">rds.language.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="access_rds_language_wizard_user" model="ir.model.access">
        <field name="name">rds.language.wizard.user</field><field name="model_id" ref="model_rds_language_wizard"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
</odoo>
