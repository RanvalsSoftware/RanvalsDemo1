<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rds_template_list" model="ir.ui.view">
        <field name="name">rds.template.list</field>
        <field name="model">rds.template</field>
        <field name="arch" type="xml">
            <list js_class="rds_sidebar_list"
                  class="rds-template-list"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="layout_style" string="Layout Style"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="target_model_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="active" string="Active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rds_template_search" model="ir.ui.view">
        <field name="name">rds.template.search</field>
        <field name="model">rds.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="target_model_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]" help="Show archived templates"/>
                <filter name="filter_all" string="All" domain="[('active', 'in', [True, False])]" help="Show all active and archived templates"/>
                <separator/>
                <filter name="filter_default" string="Default" domain="[('is_default', '=', True)]"/>
                <separator/>
                <filter string="Design" name="group_layout" context="{'group_by': 'layout_style'}"/>
                <filter string="Model" name="group_model" context="{'group_by': 'target_model_id'}"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_rds_template_form" model="ir.ui.view">
        <field name="name">rds.template.form</field>
        <field name="model">rds.template</field>
        <field name="arch" type="xml">
            <form string="Document Template"
                  js_class="rds_sidebar_form"
                  class="rds-template-form">
                <header>
                    <button name="action_open_add_field" type="object" string="Add Field" icon="fa-plus" class="btn-primary" groups="ranvals_document_studio.group_rds_manager"/>
                    <field name="active" string="Active" widget="boolean_toggle"/>
                </header>
                <sheet class="rds-template-sheet">
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1><field name="name" placeholder="e.g. Corporate Quotation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="layout_style"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="target_model_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="logo_height_mm"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview" name="preview">
                            <div class="rds-template-preview-page">
                                <div class="rds-preview-stage"
                                     role="region"
                                     aria-label="Document template preview"
                                     tabindex="0">
                                    <field name="preview_html" widget="html" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </page>
                        <page string="Design" name="design">
                            <div class="rds-template-design-page">
                                <div class="rds-template-settings-grid">
                                    <section class="rds-template-settings-card">
                                        <div class="rds-template-settings-card__header">
                                            <span class="rds-template-settings-card__icon"><i class="fa fa-paint-brush" title="Colors"/></span>
                                            <span><strong>Colors</strong><small>Customize the color palette used by your template.</small></span>
                                        </div>
                                        <group col="1" class="rds-template-settings-card__fields">
                                        <field name="primary_color"/>
                                        <field name="secondary_color"/>
                                        <field name="accent_color"/>
                                        <field name="text_color"/>
                                        </group>
                                    </section>
                                    <section class="rds-template-settings-card">
                                        <div class="rds-template-settings-card__header">
                                            <span class="rds-template-settings-card__icon"><i class="fa fa-font" title="Typography"/></span>
                                            <span><strong>Typography</strong><small>Manage fonts and text settings.</small></span>
                                        </div>
                                        <group col="1" class="rds-template-settings-card__fields">
                                        <field name="heading_font"/>
                                        <field name="body_font"/>
                                        <field name="tagline"/>
                                        <field name="footer_text"/>
                                        </group>
                                    </section>
                                </div>
                            </div>
                        </page>
                        <page string="Blocks" name="blocks" class="rds-template-blocks-page">
                            <div class="rds-template-settings-card rds-template-settings-card--wide">
                                <div class="rds-template-settings-card__header">
                                    <span class="rds-template-settings-card__icon"><i class="fa fa-th-large" title="Document Blocks"/></span>
                                    <span><strong>Document Blocks</strong><small>Select the content sections to include in the export.</small></span>
                                </div>
                                <group>
                                    <group>
                                    <field name="show_company"/>
                                    <field name="show_partner"/>
                                    <field name="show_metadata"/>
                                    </group>
                                    <group>
                                    <field name="show_notes"/>
                                    <field name="show_bank"/>
                                    <field name="show_footer"/>
                                    </group>
                                </group>
                                <field name="notes_text" widget="html"/>
                            </div>
                        </page>
                        <page string="Fields" name="fields" class="rds-template-fields-page">
                            <div class="rds-fields-toolbar">
                                <div>
                                    <strong>Export Fields</strong>
                                    <small>Manage which fields appear in the document, their order, and formatting.</small>
                                </div>
                                <button name="action_open_add_field"
                                        type="object"
                                        string="Add Field"
                                        icon="fa-plus"
                                        class="btn-primary"
                                        groups="ranvals_document_studio.group_rds_manager"/>
                            </div>
                            <field name="field_ids"
                                   class="rds-template-fields-list"
                                   context="{'default_template_id': id}"
                                   nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="active"/>
                                    <field name="section"/>
                                    <field name="source_model_id"/>
                                    <field name="field_id" domain="[('model_id', '=', source_model_id)]"/>
                                    <field name="field_path"/>
                                    <field name="label"/>
                                    <field name="icon_class"/>
                                    <field name="value_type"/>
                                    <field name="alignment"/>
                                    <field name="width_percent"/>
                                    <field name="hide_if_empty"/>
                                    <field name="bold"/>
                                    <field name="highlight"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rds_template" model="ir.actions.act_window">
        <field name="name">DocuCraft Templates</field>
        <field name="res_model">rds.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rds_template_search"/>
        <field name="context">{'rds_sidebar_menu': 'ranvals_document_studio.menu_rds_templates'}</field>
    </record>

    <record id="action_rds_template_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rds_template_list"/>
        <field name="act_window_id" ref="action_rds_template"/>
    </record>

    <record id="action_rds_template_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rds_template_form"/>
        <field name="act_window_id" ref="action_rds_template"/>
    </record>
</odoo>
