<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User-facing branding. Technical module names and XML IDs stay unchanged. -->
    <record id="module_category_rds" model="ir.module.category">
        <!-- Odoo 19 builds the user-rights arch from this value without XML
             escaping it. Keep the category name free of XML metacharacters. -->
        <field name="name">DocuCraft</field>
        <field name="description">DocuCraft document templates, PDF / DOCX / PNG export, and access permissions</field>
    </record>

    <record id="privilege_rds" model="res.groups.privilege">
        <field name="name">DocuCraft Management</field>
        <field name="description">DocuCraft document template and export permissions</field>
    </record>

    <record id="paperformat_rds_a4" model="report.paperformat">
        <field name="name">DocuCraft A4</field>
    </record>

    <record id="menu_rds_root" model="ir.ui.menu">
        <field name="name">DocuCraft</field>
        <field name="web_icon">ranvals_document_studio,static/description/icon.png</field>
    </record>

    <record id="action_rds_connectors" model="ir.actions.act_window">
        <field name="name">DocuCraft Connectors</field>
    </record>
    <record id="action_rds_connectors_dashboard" model="ir.actions.client">
        <field name="name">DocuCraft Connectors</field>
    </record>
    <record id="action_rds_template" model="ir.actions.act_window">
        <field name="name">DocuCraft Templates</field>
    </record>
    <record id="action_rds_export_log" model="ir.actions.act_window">
        <field name="name">DocuCraft Export History</field>
    </record>
    <record id="action_rds_export_dashboard" model="ir.actions.client">
        <field name="name">DocuCraft Export History</field>
    </record>
</odoo>
