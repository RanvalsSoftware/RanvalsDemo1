<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_rds_export_job" model="ir.sequence">
        <field name="name">DocuCraft Arka Plan İşi</field>
        <field name="code">rds.export.job</field>
        <field name="prefix">RDS-JOB-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_rds_export_jobs" model="ir.cron">
        <field name="name">DocuCraft: arka plan dışa aktarımlarını işle</field>
        <field name="model_id" ref="model_rds_export_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_jobs(limit=3)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
