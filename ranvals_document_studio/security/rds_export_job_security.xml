<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_rds_export_job_owner" model="ir.rule">
        <field name="name">DocuCraft arka plan işleri: kullanıcı kendi işleri</field>
        <field name="model_id" ref="model_rds_export_job"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_rds_export_job_manager" model="ir.rule">
        <field name="name">DocuCraft arka plan işleri: yöneticiler izinli şirketler</field>
        <field name="model_id" ref="model_rds_export_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ranvals_document_studio.group_rds_manager'))]"/>
    </record>

    <record id="rule_rds_export_job_system" model="ir.rule">
        <field name="name">DocuCraft arka plan işleri: sistem yöneticileri</field>
        <field name="model_id" ref="model_rds_export_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
