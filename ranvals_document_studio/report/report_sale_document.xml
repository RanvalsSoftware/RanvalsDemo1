                        <table style="table-layout:fixed;"><tr>
                            <td style="width:52%;padding:7px;"><t t-call="ranvals_document_studio.rds_logo"/></td>
                            <td t-att-style="'width:48%;padding:14px 7px;text-align:right;font-size:13px;font-style:italic;color:' + ctx['theme']['accent'] + ';font-family:' + ctx['theme']['heading_font'] + ';'" t-out="ctx.get('tagline')"/>
                        </tr></table>
                        <div style="margin:5mm 5px 4mm 5px;">
                            <div class="rds-title" t-att-style="'font-family:%s;color:%s;' % (ctx['theme']['heading_font'], ctx['theme']['text'])" t-out="ctx['title']"/>
                            <div t-att-style="'width:38px;border-top:3px solid %s;margin:8px 0;' % ctx['theme']['accent']"/>
                            <div class="rds-number"><t t-call="ranvals_document_studio.rds_document_number_label"/>&#160;<strong t-att-style="'color:%s;' % ctx['theme']['accent']" t-out="ctx['number']"/></div>
                        </div>
                        <table class="rds-two-columns"><tr>
                            <td><div class="rds-card">
                                <t t-set="block_title" t-value="ctx['labels']['company_info']"/>
                                <t t-set="block_info" t-value="ctx['company_info']"/>
                                <t t-set="block_icon" t-value="'fa-building-o'"/>
                                <t t-call="ranvals_document_studio.rds_info_block"/>
                            </div></td>
                            <td><div class="rds-card">
                                <t t-set="block_title" t-value="ctx['labels']['partner_info']"/>
                                <t t-set="block_info" t-value="ctx['partner_info']"/>
                                <t t-set="block_icon" t-value="'fa-user-o'"/>
                                <t t-call="ranvals_document_studio.rds_info_block"/>
                            </div></td>
                        </tr></table>
                        <t t-call="ranvals_document_studio.rds_common_body"/>
                    </div>
                    <div class="oe_structure"/>
                </t>
            </t>
        </t>
    </template>

